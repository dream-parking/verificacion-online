# Local runs use the defaults in application.properties + compose.yaml (docker compose up -d).
# Deployed environments get these from Container Apps secrets, never from the repo.
APP_ENV=local
DB_URL=jdbc:postgresql://localhost:5432/verificacion
DB_USER=verificacion
DB_PASSWORD=verificacion

# Consola: primer administrador y clave de firma de tokens (ver docs/integracion-api.md).
# Sin ellos la consola no tiene con qué iniciar sesión / los tokens no sobreviven a un reinicio.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@ceiba.example
APP_BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave-123
APP_JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
